# =========================================================================
# AI-Powered Predictive Budget Management System - Environment Template
# Copy this file to .env and configure your credentials, or run:
# python configure_database.py
# =========================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PGADMIN_PASSWORD
POSTGRES_DB=budget_management_system
POSTGRES_PORT=5433

BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_HTTP_PORT=8080

POSTGRES_URL=postgresql://postgres:YOUR_PGADMIN_PASSWORD@localhost:5432/budget_management_system
MONGO_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/budget_management_system?retryWrites=true&w=majority
